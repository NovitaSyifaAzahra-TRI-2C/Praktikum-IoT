    {
        "id": "f602d31dbc9aa6b0",
        "type": "function",
        "z": "72e2def0dc0fbcdb",
        "name": "function 1",
        "func": "// Mengambil status LED sebelumnya dari context (default 0/mati jika belum ada)\nlet ledState = context.get('ledState') || 0;\n\n// Ambil nilai suhu dari msg.payload (asumsi masukan bertipe angka atau objek { temperature: value })\n// Jika msg.payload berbentuk angka langsung:\nlet temp = typeof msg.payload === 'object' ? msg.payload.temperature : msg.payload;\n\n// Logika Histeresis\nif (temp > 24.5) {\n    ledState = 1; // Menyala jika suhu melebihi 24.5°C\n} else if (temp < 23.0) {\n    ledState = 0; // Padam jika suhu kurang dari 23.0°C\n}\n// Jika suhu berada di antara 23.0°C dan 24.5°C, nilai ledState tidak berubah (mempertahankan kondisi terakhir)\n\n// Simpan kembali status LED terbaru ke context Node-RED\ncontext.set('ledState', ledState);\n\n// Format output sesuai kebutuhan\nmsg.payload = {\n    \"led\": ledState\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
